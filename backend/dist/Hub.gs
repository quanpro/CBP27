function revealKey(passedCourse) { return !!passedCourse; }

// ---------------------------------------------------------------- spaced recall (F11)

function parseDays(s) {
  var out = str(s).split(/[,;\s]+/).map(function (x) { return toInt(x, -1); }).filter(function (n) { return n > 0; });
