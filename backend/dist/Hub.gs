/** Pass mark may be 0.8 or 80; compare in integers to avoid float error. */
function isPass(nCorrect, nItems, passMark) {
  var pm = toNum(passMark, 0.8);
  if (pm > 1) pm = pm / 100;
  return nItems > 0 && nCorrect * 1000 >= Math.round(pm * 1000) * nItems;
