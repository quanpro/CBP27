    if (it.assessment === 'baseline_p1' && BL_FORMS.indexOf(it.form) < 0) errors.push(where + ': form must be A, B or C');
    if (it.assessment !== 'baseline_p1' && it.form !== 'ONE') errors.push(where + ': form must be ONE');
