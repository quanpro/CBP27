    if (exIds[id]) errors.push('Exhibits row ' + (i + 2) + ' (' + id + '): duplicate exhibit_id');
    exIds[id] = true;
    if (!str(e.md_en).trim()) errors.push('Exhibits ' + id + ': md_en is empty');
