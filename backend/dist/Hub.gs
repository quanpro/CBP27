// ---------------------------------------------------------------- lockout (F2, hardened)

var LOCK_WINDOW_MS = 7 * DAY_MS;
var HARD_LOCK_AFTER = 3;
/** Roster.locked_until for a lock that only an admin can lift ("Reset a PIN…" / "Clear a lock…"). */
