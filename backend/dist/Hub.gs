  perDay = perDay || 3;
  var ids = shuffle(formItemIds.slice().sort(), seed);
  if (!ids.length) return [];
  var out = [];
  for (var i = 0; i < Math.min(perDay, ids.length); i++) out.push(ids[(dayIndex * perDay + i) % ids.length]);
  return out;
