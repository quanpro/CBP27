}

/** F2: SHA-256(PIN_PEPPER + ":" + salt + ":" + pin) as lowercase hex. digestFn(string) → bytes. */
function hashPin(pepper, salt, pin, digestFn) {
  return bytesToHex(digestFn(str(pepper) + ':' + str(salt) + ':' + str(pin)));
}

function constantTimeEqual(a, b) {
  a = str(a); b = str(b);
