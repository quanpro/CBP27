  return list;
}

function cases_() {
  var list = cacheGet_('cases');
  if (!list) {
    list = readTable_('Cases').rows.map(function (c) {
      return {
        case_id: String(c.case_id || '').trim(), title_en: c.title_en || '', title_vi: c.title_vi || '',
        context_en: c.context_en || '', context_vi: c.context_vi || ''
