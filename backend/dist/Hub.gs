function rosterRows_() { return readTable_('Roster').rows; }

function findRosterRow_(code) {
  var c = normCode(code);
  if (!c) return null;
  var rows = rosterRows_();
  for (var i = 0; i < rows.length; i++) if (normCode(rows[i].employee_code) === c) return rows[i];
