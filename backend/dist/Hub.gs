  var d = new Date(ms + TZ_OFFSET_MS);
  var dayNum = (d.getUTCDay() + 6) % 7; // Monday = 0
  var thursday = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate() - dayNum + 3);
  var year = new Date(thursday).getUTCFullYear();
